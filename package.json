{
  "name": "jobflow",
  "version": "1.0.0",
  "description": "Job Automation & Execution Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run start --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "dev:worker": "npm run dev --workspace=worker",
    "start:web": "npm run start --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build:worker": "npm run build --workspace=worker",
    "db:migrate": "npm run migrate --workspace=db",
    "db:push": "npm run push --workspace=db",
    "db:studio": "npm run studio --workspace=db",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.3.2"
  }
}
